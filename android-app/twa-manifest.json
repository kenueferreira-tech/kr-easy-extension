{
  "packageId": "com.kenueferreira.kreasyextension",
  "host": "kr-easy-extension.vercel.app",
  "name": "KR Easy Extension",
  "launcherName": "KR Easy",
  "display": "standalone",
  "themeColor": "#07110B",
  "themeColorDark": "#000000",
  "navigationColor": "#000000",
  "navigationColorDark": "#000000",
  "navigationDividerColor": "#000000",
  "navigationDividerColorDark": "#000000",
  "backgroundColor": "#050B08",
  "enableNotifications": true,
  "startUrl": "/mobile.html?source=play",
  "iconUrl": "https://kr-easy-extension.vercel.app/icons/icon-512.png",
  "maskableIconUrl": "https://kr-easy-extension.vercel.app/icons/icon-512.png",
  "splashScreenFadeOutDuration": 300,
  "signingKey": {
    "path": "./kr-easy-upload.keystore",
    "alias": "kr-easy-upload"
  },
  "appVersionName": "1.1.0",
  "appVersionCode": 2,
  "shortcuts": [
    { "name": "Scripts rápidos", "short_name": "Scripts", "url": "https://kr-easy-extension.vercel.app/mobile.html?source=play&screen=scripts", "icon": "shortcut_scripts" },
    { "name": "Gerar mensagem", "short_name": "Gerador", "url": "https://kr-easy-extension.vercel.app/mobile.html?source=play&screen=generator", "icon": "shortcut_generator" }
  ],
  "shareTarget": {
    "action": "https://kr-easy-extension.vercel.app/compartilhar.html",
    "method": "GET",
    "enctype": "application/x-www-form-urlencoded",
    "params": { "title": "title", "text": "text", "url": "url" }
  },
  "generatorApp": "bubblewrap-cli",
  "webManifestUrl": "https://kr-easy-extension.vercel.app/manifest.webmanifest",
  "fallbackType": "customtabs",
  "features": {},
  "alphaDependencies": { "enabled": false },
  "enableSiteSettingsShortcut": true,
  "isChromeOSOnly": false,
  "isMetaQuest": false,
  "fullScopeUrl": "https://kr-easy-extension.vercel.app/",
  "minSdkVersion": 21,
  "orientation": "portrait",
  "fingerprints": [],
  "additionalTrustedOrigins": [],
  "retainedBundles": [],
  "protocolHandlers": [],
  "fileHandlers": [],
  "launchHandlerClientMode": "",
  "displayOverride": [],
  "appVersion": "1.1.0"
}
